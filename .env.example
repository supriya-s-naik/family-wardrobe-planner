# Model provider
NEBIUS_API_KEY=
NEBIUS_BASE_URL=https://api.tokenfactory.nebius.com/v1/
NEBIUS_MODEL=Qwen/Qwen3-30B-A3B-Instruct-2507
NEBIUS_VISION_MODEL=google/gemma-3-27b-it

# Retrieval
PINECONE_API_KEY=
PINECONE_INDEX_NAME=wardrobe-guidance
PINECONE_NAMESPACE=reviewed-guidance-v1
PINECONE_EMBED_MODEL=llama-text-embed-v2

# Long-term preference memory
MEM0_API_KEY=

# Optional local application database path. Defaults to data/wardrobe_planner.db.
WARDROBE_DB_PATH=

# Tracing and evaluations
LANGSMITH_API_KEY=
LANGSMITH_TRACING=true
LANGSMITH_PROJECT=wardrobe-planner

# Optional live weather provider. Seeded weather is used when unset.
WEATHER_API_KEY=
